#!/bin/sh
# Stands in for opencode in catalog.rs's tests. FAKE_MODE=hang: `models` never ends;
# FAKE_MODE=hangversion: `--version` never ends. A hung one notes its pid in $FAKE_OUT.
D=$(dirname "$0")/..
case "$FAKE_MODE $*" in
"hangversion --version") echo $$ > "$FAKE_OUT/opencode-version.pid"; exec sleep 30 ;;
"hang models --verbose") echo $$ > "$FAKE_OUT/opencode.pid"; exec sleep 30 ;;
esac
case "$*" in
--version) echo "0.0.1" ;;
"models --verbose") cat "$D/opencode-models.txt" ;;
esac
