#!/usr/bin/env python3
# Stands in for opencode in signin.rs's tests: --version, `auth list`, `auth logout <provider>` and
# `serve` with GET /provider/auth and the provider oauth routes, behind OPENCODE_SERVER_PASSWORD.
# FAKE_MODE: ok, fail (the callback is refused), hang (the callback never answers). Notes its pid
# and each oauth call.
import base64, json, os, sys, time
from http.server import BaseHTTPRequestHandler, HTTPServer
args, out, mode = sys.argv[1:], os.environ.get("FAKE_OUT", ""), os.environ.get("FAKE_MODE", "ok")
if args == ["--version"]:
    print("0.0.1")
    sys.exit(0)
if args[:2] == ["auth", "list"]:
    print("\x1b[0m")
    print("┌  Credentials \x1b[90m~/.local/share/opencode/auth.json")
    print("│")
    print("●  OpenRouter \x1b[90mapi")
    print("│")
    print("●  OpenAI \x1b[90moauth")
    print("│")
    print("●  sk-or-v1-00000000000000000000000000000000 \x1b[90mapi")
    print("│")
    print("└  3 credentials")
    print()
    print("┌  Environment")
    print("│")
    print("●  Anthropic \x1b[90mANTHROPIC_API_KEY")
    print("│")
    print("└  1 environment variable")
    sys.exit(0)
if args[:2] == ["auth", "logout"]:
    open(os.path.join(out, "opencode-logout"), "w").write(args[2])
    print("\x1b[0m\n┌  Remove credential\n│\n└  Logout successful")
    sys.exit(0)
if args[:1] != ["serve"]:
    sys.exit(2)
port = int(args[args.index("--port") + 1])
want = "Basic " + base64.b64encode(("opencode:" + os.environ["OPENCODE_SERVER_PASSWORD"]).encode()).decode()
METHODS = {
    "openai": [{"type": "oauth", "label": "ChatGPT Pro/Plus (browser)"}, {"type": "oauth", "label": "ChatGPT Pro/Plus (headless)"},
               {"type": "api", "label": "Manually enter API Key"}],
    "github-copilot": [{"type": "oauth", "label": "Login with GitHub Copilot"}],
    "anthropic": [{"type": "api", "label": "API key"}, {"type": "oauth", "label": "Claude Pro/Max"}],
}
class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass
    def reply(self, code, v):
        b = json.dumps(v).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)
    def ok(self):
        if self.headers.get("Authorization") == want:
            return True
        self.reply(401, {"message": "unauthorized"})
    def do_GET(self):
        if self.ok():
            self.reply(200, METHODS) if self.path.startswith("/provider/auth") else self.reply(404, {"message": "not found"})
    def do_POST(self):
        if not self.ok():
            return
        b = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
        _, pid, _, what = self.path.split("?")[0].strip("/").split("/")
        with open(os.path.join(out, "opencode-calls"), "a") as f:
            f.write(json.dumps({"what": what, "provider": pid, "body": b}) + "\n")
        if what == "authorize":
            if pid == "openai" and b["method"] == 0:
                return self.reply(200, {"url": "https://auth.example/opencode?state=s3", "method": "auto",
                                        "instructions": "Complete authorization in your browser. This window will close automatically."})
            if pid in ("openai", "github-copilot"):
                return self.reply(200, {"url": "https://auth.example/device", "method": "auto", "instructions": "Enter code: OCDE-1234"})
            return self.reply(200, {"url": "https://claude.example/oauth", "method": "code", "instructions": "Paste the authorization code here: "})
        if mode == "hang":
            time.sleep(60)
        if mode == "fail":
            return self.reply(400, {"data": {"message": "Token exchange failed: 400"}})
        if pid == "anthropic" and b.get("code") != "good#code":
            return self.reply(200, False)
        time.sleep(0.2)
        self.reply(200, True)
srv = HTTPServer(("127.0.0.1", port), H)
if out:
    open(os.path.join(out, "opencode.pid"), "w").write(str(os.getpid()))
print(f"opencode server listening on http://127.0.0.1:{port}", flush=True)
srv.serve_forever()
