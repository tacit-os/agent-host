#!/bin/sh
# Stands in for secret-tool in accounts.rs's key-account test: the keyring holds every key looked up.
# k-gated (a_start_reads_its_key_outside_the_hosts_lock): each lookup is noted in $HOME/k-gated.asked, waits for
# $HOME/k-gated.go, and finds no such key.
case " $* " in
*" k-gated "*)
    echo lookup >> "$HOME/k-gated.asked"
    while [ ! -e "$HOME/k-gated.go" ]; do sleep 0.05; done
    exit 1 ;;
esac
[ "$1" = lookup ] && echo 'test-key-0000000000'
